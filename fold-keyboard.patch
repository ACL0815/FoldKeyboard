@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.fold;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+import android.provider.Settings;
+import android.view.View;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.RadioButton;
+import android.widget.RadioGroup;
+import android.widget.ScrollView;
+import android.widget.SeekBar;
+import android.widget.TextView;
+import helium314.keyboard.latin.R;
+
+/** Available from both the regular settings and Android's accessibility service settings. */
+public final class FoldTrackpadSettingsActivity extends Activity {
+    private TextView status;
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        setTitle(R.string.fold_settings);
+        ScrollView scroll = new ScrollView(this);
+        LinearLayout content = new LinearLayout(this);
+        content.setOrientation(LinearLayout.VERTICAL);
+        int padding = Math.round(20 * getResources().getDisplayMetrics().density);
+        content.setPadding(padding, padding, padding, padding);
+        scroll.addView(content);
+        setContentView(scroll);
+        scroll.setOnApplyWindowInsetsListener((view, insets) -> {
+            view.setPadding(insets.getSystemWindowInsetLeft(), insets.getSystemWindowInsetTop(),
+                    insets.getSystemWindowInsetRight(), insets.getSystemWindowInsetBottom());
+            return insets;
+        });
+        text(content, R.string.fold_settings, 25);
+        text(content, R.string.fold_intro, 16);
+        status = text(content, R.string.fold_enable_pointer, 16);
+        Button enable = new Button(this);
+        enable.setText(R.string.fold_enable_pointer);
+        enable.setOnClickListener(v -> {
+            startActivity(new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS));
+        });
+        content.addView(enable);
+        text(content, R.string.fold_mode, 19);
+        RadioGroup modes = new RadioGroup(this);
+        String[] values = {"auto", "always", "off"};
+        int[] labels = {R.string.fold_auto, R.string.fold_always, R.string.fold_off};
+        String current = FoldTrackpadConfig.prefs(this).getString(FoldTrackpadConfig.MODE, "auto");
+        for (int i = 0; i < values.length; i++) {
+            RadioButton button = new RadioButton(this);
+            button.setId(View.generateViewId());
+            button.setText(labels[i]);
+            button.setTag(values[i]);
+            modes.addView(button);
+            if (values[i].equals(current)) modes.check(button.getId());
+        }
+        modes.setOnCheckedChangeListener((group, id) -> {
+            RadioButton button = group.findViewById(id);
+            FoldTrackpadConfig.prefs(this).edit().putString(FoldTrackpadConfig.MODE,
+                    (String) button.getTag()).apply();
+        });
+        content.addView(modes);
+        TextView width = text(content, R.string.fold_width, 19);
+        SeekBar widthSlider = new SeekBar(this);
+        widthSlider.setContentDescription(getString(R.string.fold_width));
+        widthSlider.setMax(24);
+        int storedWidth = FoldTrackpadConfig.prefs(this).getInt(FoldTrackpadConfig.WIDTH, 0);
+        widthSlider.setProgress(storedWidth == 0 ? 0 : (storedWidth - 240) / 10);
+        updateWidthLabel(width, storedWidth);
+        widthSlider.setOnSeekBarChangeListener(new SliderListener() {
+            @Override public void onProgressChanged(SeekBar bar, int progress, boolean user) {
+                if (!user) return;
+                int dp = progress == 0 ? 0 : 240 + progress * 10;
+                FoldTrackpadConfig.prefs(FoldTrackpadSettingsActivity.this).edit()
+                        .putInt(FoldTrackpadConfig.WIDTH, dp).apply();
+                updateWidthLabel(width, dp);
+            }
+        });
+        content.addView(widthSlider);
+        TextView speed = text(content, R.string.fold_speed, 19);
+        SeekBar speedSlider = new SeekBar(this);
+        speedSlider.setContentDescription(getString(R.string.fold_speed));
+        speedSlider.setMax(21);
+        float storedSpeed = FoldTrackpadConfig.prefs(this).getFloat(FoldTrackpadConfig.SPEED, 1f);
+        speedSlider.setProgress(Math.round((storedSpeed - 0.4f) * 10));
+        speed.setText(getString(R.string.fold_speed_value, storedSpeed));
+        speedSlider.setOnSeekBarChangeListener(new SliderListener() {
+            @Override public void onProgressChanged(SeekBar bar, int progress, boolean user) {
+                if (!user) return;
+                float value = 0.4f + progress / 10f;
+                FoldTrackpadConfig.prefs(FoldTrackpadSettingsActivity.this).edit()
+                        .putFloat(FoldTrackpadConfig.SPEED, value).apply();
+                speed.setText(getString(R.string.fold_speed_value, value));
+            }
+        });
+        content.addView(speedSlider);
+        text(content, R.string.fold_gestures, 16);
+    }
+
+    private void updateWidthLabel(TextView label, int dp) {
+        label.setText(dp == 0 ? getString(R.string.fold_width_auto) : getString(R.string.fold_width_value, dp));
+    }
+    private TextView text(LinearLayout parent, int resource, int size) {
+        TextView view = new TextView(this);
+        view.setText(resource);
+        view.setTextSize(size);
+        int padding = Math.round(8 * getResources().getDisplayMetrics().density);
+        view.setPadding(0, padding, 0, padding);
+        parent.addView(view);
+        return view;
+    }
+    @Override protected void onResume() {
+        super.onResume();
+        status.setText(FoldPointerService.isConnected() ? R.string.fold_connected : R.string.fold_disconnected);
+    }
+    @Override protected void onPause() {
+        helium314.keyboard.keyboard.KeyboardSwitcher.getInstance().setThemeNeedsReload();
+        super.onPause();
+    }
+    private abstract static class SliderListener implements SeekBar.OnSeekBarChangeListener {
+        @Override public void onStartTrackingTouch(SeekBar bar) {}
+        @Override public void onStopTrackingTouch(SeekBar bar) {}
+    }
+}
