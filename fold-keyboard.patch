@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.fold;
+
+/** Device-independent layout decisions, also exercised by the host-side tests. */
+public final class FoldLayoutPolicy {
+    private FoldLayoutPolicy() {}
+
+    public static boolean enabled(String mode, float widthDp, float heightDp, boolean locked) {
+        if (locked || "off".equals(mode) || widthDp < 480) return false;
+        return "always".equals(mode) || (widthDp >= 600 && heightDp >= 600);
+    }
+
+    public static int keyboardWidth(int availablePx, float density, float preferredDp) {
+        float phoneWidth = Math.max(240, Math.min(480, preferredDp)) * density;
+        return Math.max(1, Math.round(Math.min(availablePx * 0.45f, phoneWidth)));
+    }
+
+    public static float gain(float dx, float dy, long elapsedMs, float density, float sensitivity) {
+        double speedDpPerMs = Math.hypot(dx, dy) / Math.max(1, density) / Math.max(1, elapsedMs);
+        return Math.max(0.4f, Math.min(2.5f, sensitivity))
+                * (0.8f + 1.8f * (float) Math.min(1, speedDpPerMs / 1.5));
+    }
+}
