index 0000000..a2be38e
--- /dev/null
+++ b/app/src/main/java/helium314/keyboard/fold/TrackpadGestureEngine.java
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.fold;
+
+/** No Android dependencies. Injection is requested only after all trackpad fingers lift. */
+public final class TrackpadGestureEngine {
+    public interface Sink {
+        void move(float dx, float dy);
+        void click(int count);
+        void longClick();
+        void scroll(float dx, float dy);
+        void beginDrag();
+        void endDrag();
+        void cancelDrag();
+    }
+
+    private final Sink sink;
+    private final float slop, density, sensitivity;
+    private final long doubleTapMs, longPressMs;
+    private boolean active, moved, multi, draining, dragging, secondTap, forceDrag;
+    private float downX, downY, x, y, scrollX, scrollY;
+    private long downTime, lastTime, pendingTap = -1;
+
+    public TrackpadGestureEngine(Sink sink, float slop, float density, float sensitivity,
+            long doubleTapMs, long longPressMs) {
+        this.sink = sink;
+        this.slop = slop;
+        this.density = density;
+        this.sensitivity = sensitivity;
+        this.doubleTapMs = doubleTapMs;
+        this.longPressMs = longPressMs;
+    }
+
+    public void armDrag() { forceDrag = true; }
+
+    public void down(float x, float y, long time) {
+        flushTap(time);
+        secondTap = pendingTap >= 0;
+        pendingTap = -1;
+        active = true;
+        moved = multi = draining = dragging = false;
+        downX = this.x = x;
+        downY = this.y = y;
+        downTime = lastTime = time;
+        scrollX = scrollY = 0;
+        if (forceDrag) {
+            dragging = true;
+            forceDrag = false;
+            sink.beginDrag();
+        }
+    }
+
+    public void pointersChanged(int remaining, float centroidX, float centroidY, long time) {
+        if (!active) return;
+        if (remaining > 2) { cancel(); return; }
+        if (remaining == 2) {
+            if (dragging) sink.cancelDrag();
+            dragging = false;
+            multi = true;
+            secondTap = false;
+        } else if (multi) draining = true;
+        x = centroidX;
+        y = centroidY;
+        lastTime = time;
+    }
+
+    public void move(float nextX, float nextY, long time) {
+        if (!active || draining) return;
+        float dx = nextX - x, dy = nextY - y;
+        if (multi) {
+            scrollX += dx;
+            scrollY += dy;
+        } else {
+            boolean crossesSlop = Math.hypot(nextX - downX, nextY - downY) > slop;
+            if (!moved && crossesSlop) {
+                if (!dragging && (secondTap || time - downTime >= longPressMs)) {
+                    dragging = true;
+                    sink.beginDrag();
+                }
+                moved = true;
+            }
+            if (moved || dragging) {
+                float gain = FoldLayoutPolicy.gain(dx, dy, time - lastTime, density, sensitivity);
+                sink.move(dx * gain, dy * gain);
+            }
+        }
+        x = nextX;
+        y = nextY;
+        lastTime = time;
+    }
+
+    public void up(long time) {
+        if (!active) return;
+        active = false;
+        if (multi) {
+            if (Math.hypot(scrollX, scrollY) > slop) sink.scroll(scrollX, scrollY);
+        } else if (dragging) {
+            sink.endDrag();
+        } else if (!moved) {
+            if (time - downTime >= longPressMs) sink.longClick();
+            else if (secondTap) sink.click(2);
+            else pendingTap = time;
+        }
+        dragging = false;
+    }
+
+    public void flushTap(long time) {
+        if (!active && pendingTap >= 0 && time - pendingTap >= doubleTapMs) {
+            pendingTap = -1;
+            sink.click(1);
+        }
+    }
+
+    public void cancel() {
+        if (dragging) sink.cancelDrag();
+        active = dragging = forceDrag = secondTap = false;
+        pendingTap = -1;
+    }
+}
