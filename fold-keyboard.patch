+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.fold;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.content.Intent;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.os.SystemClock;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewConfiguration;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import helium314.keyboard.latin.R;
+
+public final class TrackpadPanel extends LinearLayout {
+    private final Pad pad;
+    public TrackpadPanel(Context context) {
+        super(context);
+        setOrientation(VERTICAL);
+        setLayoutDirection(LAYOUT_DIRECTION_LTR);
+        setBackgroundColor(0xFF18212A);
+        LinearLayout actions = new LinearLayout(context);
+        actions.setGravity(Gravity.CENTER);
+        Button settings = new Button(context);
+        settings.setText(R.string.fold_settings);
+        settings.setOnClickListener(v -> context.startActivity(new Intent(context,
+                FoldTrackpadSettingsActivity.class).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)));
+        Button drag = new Button(context);
+        drag.setText(R.string.fold_drag);
+        pad = new Pad(context);
+        drag.setOnClickListener(v -> {
+            pad.engine.armDrag();
+            pad.dragArmed = true;
+            pad.invalidate();
+        });
+        actions.addView(settings, new LinearLayout.LayoutParams(0, LayoutParams.WRAP_CONTENT, 1));
+        actions.addView(drag, new LinearLayout.LayoutParams(0, LayoutParams.WRAP_CONTENT, 1));
+        addView(actions, new LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT));
+        addView(pad, new LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, 0, 1));
+    }
+
+    public void cancel() { pad.cancel(); }
+
+    private static final class Pad extends View implements TrackpadGestureEngine.Sink {
+        private final TrackpadGestureEngine engine;
+        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private boolean dragArmed;
+        private final Runnable flush = () -> engineFlush();
+
+        Pad(Context context) {
+            super(context);
+            setFocusable(true);
+            setContentDescription(context.getString(R.string.fold_pad_description));
+            ViewConfiguration config = ViewConfiguration.get(context);
+            engine = new TrackpadGestureEngine(this, config.getScaledTouchSlop(),
+                    getResources().getDisplayMetrics().density,
+                    FoldTrackpadConfig.prefs(context).getFloat(FoldTrackpadConfig.SPEED, 1f),
+                    ViewConfiguration.getDoubleTapTimeout(), ViewConfiguration.getLongPressTimeout());
+        }
+
+        private void engineFlush() { engine.flushTap(SystemClock.uptimeMillis()); }
+        void cancel() {
+            removeCallbacks(flush);
+            engine.cancel();
+            dragArmed = false;
+            invalidate();
+        }
+
+        @SuppressLint("ClickableViewAccessibility")
+        @Override public boolean onTouchEvent(MotionEvent event) {
+            getParent().requestDisallowInterceptTouchEvent(true);
+            float cx = 0, cy = 0;
+            int count = 0;
+            for (int i = 0; i < event.getPointerCount(); i++) {
+                if (event.getActionMasked() == MotionEvent.ACTION_POINTER_UP && i == event.getActionIndex()) continue;
+                cx += event.getX(i);
+                cy += event.getY(i);
+                count++;
+            }
+            cx /= Math.max(1, count);
+            cy /= Math.max(1, count);
+            long time = event.getEventTime();
+            switch (event.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    removeCallbacks(flush);
+                    engine.down(cx, cy, time);
+                    break;
+                case MotionEvent.ACTION_POINTER_DOWN:
+                case MotionEvent.ACTION_POINTER_UP:
+                    engine.pointersChanged(count, cx, cy, time);
+                    break;
+                case MotionEvent.ACTION_MOVE:
+                    engine.move(cx, cy, time);
+                    break;
+                case MotionEvent.ACTION_UP:
+                    engine.up(time);
+                    dragArmed = false;
+                    postDelayed(flush, ViewConfiguration.getDoubleTapTimeout() + 1L);
+                    break;
+                case MotionEvent.ACTION_CANCEL:
+                    cancel();
+                    break;
+            }
+            invalidate();
+            return true;
+        }
+
+        @Override public boolean performClick() {
+            super.performClick();
+            click(1);
+            return true;
+        }
+        @Override protected void onDetachedFromWindow() { cancel(); super.onDetachedFromWindow(); }
+        @Override protected void onWindowVisibilityChanged(int visibility) {
+            super.onWindowVisibilityChanged(visibility);
+            if (visibility != VISIBLE) cancel();
+        }
+        @Override protected void onDraw(Canvas canvas) {
+            float density = getResources().getDisplayMetrics().density;
+            paint.setColor(0xFF293541);
+            for (float px = 18 * density; px < getWidth(); px += 24 * density)
+                for (float py = 18 * density; py < getHeight(); py += 24 * density)
+                    canvas.drawCircle(px, py, density, paint);
+            paint.setTextAlign(Paint.Align.CENTER);
+            paint.setTextSize(18 * density);
+            paint.setColor(0xFFD9E6F0);
+            int label = !FoldPointerService.isConnected() ? R.string.fold_enable_pointer
+                    : dragArmed ? R.string.fold_drag_armed : R.string.fold_trackpad;
+            canvas.drawText(getContext().getString(label), getWidth() / 2f, getHeight() / 2f, paint);
+            paint.setTextSize(12 * density);
+            paint.setColor(0xFFA8BACB);
+            canvas.drawText(getContext().getString(R.string.fold_pad_hint), getWidth() / 2f,
+                    getHeight() / 2f + 26 * density, paint);
+        }
+        @Override public void move(float dx, float dy) {
+            FoldPointerService service = FoldPointerService.connected();
+            if (service != null) service.move(dx, dy);
+        }
+        @Override public void click(int count) {
+            FoldPointerService service = FoldPointerService.connected();
+            if (service != null) service.click(count);
+        }
+        @Override public void longClick() {
+            FoldPointerService service = FoldPointerService.connected();
+            if (service != null) service.longClick();
+        }
+        @Override public void scroll(float dx, float dy) {
+            FoldPointerService service = FoldPointerService.connected();
+            if (service != null) service.scroll(dx, dy);
+        }
+        @Override public void beginDrag() {
+            FoldPointerService service = FoldPointerService.connected();
+            if (service != null) service.beginDrag();
+        }
+        @Override public void endDrag() {
+            FoldPointerService service = FoldPointerService.connected();
+            if (service != null) service.endDrag();
+        }
+        @Override public void cancelDrag() {
+            FoldPointerService service = FoldPointerService.connected();
+            if (service != null) service.cancelDrag();
+        }
+    }
+}
