+<?xml version="1.0" encoding="utf-8"?>
+<!-- SPDX-License-Identifier: GPL-3.0-only -->
+<resources>
+    <string name="fold_settings">Fold Trackpad</string>
+    <string name="fold_trackpad">TRACKPAD</string>
+    <string name="fold_pointer_service">FoldKeyboard Mauszeiger</string>
+    <string name="fold_service_description">Zeigt einen Mauszeiger und führt die auf dem Tastatur-Trackpad eingegebenen Klicks, Scroll- und Ziehgesten aus. Nur bei sichtbarer Fold-Trackpad-Tastatur aktiv. Liest keine Bildschirminhalte.</string>
+    <string name="fold_intro">Links Trackpad, rechts Tastatur in Phone-Größe. Aktiviere FoldKeyboard Mauszeiger unter Eingabehilfe → Installierte Apps/Dienste.</string>
+    <string name="fold_enable_pointer">Mauszeiger aktivieren</string>
+    <string name="fold_connected">Mauszeiger-Dienst verbunden</string>
+    <string name="fold_disconnected">Mauszeiger-Dienst ist aus. Tippen funktioniert weiterhin.</string>
+    <string name="fold_mode">Layout-Modus</string>
+    <string name="fold_auto">Auto — großes inneres Display</string>
+    <string name="fold_always">Immer — ab 480 dp Breite</string>
+    <string name="fold_off">Aus — normales HeliBoard-Layout</string>
+    <string name="fold_width">Tastaturbreite</string>
+    <string name="fold_width_auto">Breite: automatisch, merkt sich äußeres Display</string>
+    <string name="fold_width_value">Breite: %1$d dp, höchstens 45%% des Displays</string>
+    <string name="fold_speed">Zeigergeschwindigkeit</string>
+    <string name="fold_speed_value">Zeigergeschwindigkeit: %1$.1f×</string>
+    <string name="fold_drag">Ziehen</string>
+    <string name="fold_drag_armed">Bewegen, zum Ablegen loslassen</string>
+    <string name="fold_pad_description">Trackpad: Ein Finger bewegt den Zeiger, Tippen klickt, zwei Finger scrollen nach dem Loslassen.</string>
+    <string name="fold_pad_hint">Tippen = Klick · 2 Finger = Scrollen</string>
+    <string name="fold_gesture_failed">Geste unterbrochen oder nicht verfügbar. Alle Finger anheben und erneut versuchen.</string>
+    <string name="fold_gestures">Ein Finger: Zeiger bewegen\nTippen: Klick\nDoppeltippen: Doppelklick\nHalten, dann loslassen: langer Klick\nZwei Finger: Scrollen beim Loslassen\nZiehen-Taste, dann bewegen: Ziehen vorzeichnen; loslassen führt aus\nDoppeltippen und bewegen: Ziehen vorzeichnen; loslassen führt aus\n\nScrollen und Ziehen werden ausgeführt, sobald alle Finger die Tastatur verlassen. Beim Ziehen wird der Zeiger grün; das Objekt folgt nach dem Loslassen. Android behandelt diese Aktionen als Touch-Eingaben. Der Mauszeiger bleibt verfügbar, solange die Tastatur offen ist.\n\nAuto aktiviert sich ab 600 dp verfügbarer Breite und Höhe. Floating- und Split-Layout gelten wieder bei ausgeschaltetem Fold Trackpad. Nach Änderungen die Tastatur schließen und erneut öffnen.</string>
+</resources>
