+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.fold;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.content.res.Configuration;
+import helium314.keyboard.latin.utils.DeviceProtectedUtils;
+import helium314.keyboard.latin.utils.ResourceUtils;
+
+public final class FoldTrackpadConfig {
+    public static final String MODE = "fold_trackpad_mode";
+    public static final String WIDTH = "fold_trackpad_width_dp";
+    public static final String SPEED = "fold_trackpad_speed";
+    private static final String COVER_WIDTH = "fold_trackpad_cover_width_dp";
+    private FoldTrackpadConfig() {}
+
+    public static SharedPreferences prefs(Context context) {
+        return DeviceProtectedUtils.getSharedPreferences(context);
+    }
+
+    public static boolean isEnabled(Context context, boolean locked) {
+        Configuration config = context.getResources().getConfiguration();
+        float width = ResourceUtils.getDefaultKeyboardWidth(context)
+                / context.getResources().getDisplayMetrics().density;
+        return FoldLayoutPolicy.enabled(prefs(context).getString(MODE, "auto"),
+                width, config.screenHeightDp, locked);
+    }
+
+    public static void rememberCoverWidth(Context context) {
+        Configuration config = context.getResources().getConfiguration();
+        if (config.orientation != Configuration.ORIENTATION_PORTRAIT) return;
+        float width = ResourceUtils.getDefaultKeyboardWidth(context)
+                / context.getResources().getDisplayMetrics().density;
+        if (width < 240 || width >= 600) return;
+        SharedPreferences prefs = prefs(context);
+        if (Math.abs(prefs.getFloat(COVER_WIDTH, 360) - width) > 1)
+            prefs.edit().putFloat(COVER_WIDTH, width).apply();
+    }
+
+    public static int keyboardWidth(Context context, int available) {
+        SharedPreferences prefs = prefs(context);
+        float preferred = prefs.getInt(WIDTH, 0);
+        if (preferred == 0) preferred = prefs.getFloat(COVER_WIDTH, 360);
+        return FoldLayoutPolicy.keyboardWidth(available,
+                context.getResources().getDisplayMetrics().density, preferred);
+    }
+}
