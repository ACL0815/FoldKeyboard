+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.fold;
+
+import android.accessibilityservice.AccessibilityService;
+import android.accessibilityservice.GestureDescription;
+import android.app.KeyguardManager;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.res.Configuration;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PixelFormat;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.util.DisplayMetrics;
+import android.view.Display;
+import android.view.Gravity;
+import android.view.View;
+import android.view.WindowManager;
+import android.view.accessibility.AccessibilityEvent;
+import android.widget.Toast;
+import java.util.ArrayDeque;
+import helium314.keyboard.latin.R;
+
+/** Same-process bridge only: no receiver or binder accepts pointer commands from other apps. */
+public final class FoldPointerService extends AccessibilityService {
+    private static FoldPointerService instance;
+    private static boolean sessionVisible;
+    private static int imeTop, touchCount;
+    private static long lastTouch;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final ArrayDeque<PendingGesture> queue = new ArrayDeque<>();
+    private WindowManager wm;
+    private CursorView cursor;
+    private WindowManager.LayoutParams cursorParams;
+    private float x, y;
+    private int screenWidth, screenHeight, epoch;
+    private boolean attached, busy;
+    private boolean receiverRegistered;
+    private Path dragPath;
+    private float dragStartX, dragStartY;
+    private int dragPoints;
+    private long lastFailure;
+
+    private final BroadcastReceiver screenOff = new BroadcastReceiver() {
+        @Override public void onReceive(Context context, Intent intent) { hideSession(); }
+    };
+
+    public static boolean isConnected() { return instance != null; }
+
+    public static void setSession(boolean visible, int top, int displayId) {
+        sessionVisible = visible && displayId == Display.DEFAULT_DISPLAY;
+        imeTop = top;
+        if (instance != null) instance.updateVisibility();
+    }
+
+    public static void hideSession() {
+        sessionVisible = false;
+        touchCount = 0;
+        if (instance != null) instance.updateVisibility();
+    }
+
+    /** Covers the entire IME, including fingers typing on its right-hand keyboard. */
+    public static void setTouchCount(int count) {
+        touchCount = count;
+        lastTouch = SystemClock.uptimeMillis();
+    }
+
+    public static FoldPointerService connected() { return instance; }
+
+    @Override protected void onServiceConnected() {
+        super.onServiceConnected();
+        instance = this;
+        wm = getSystemService(WindowManager.class);
+        cursor = new CursorView(this);
+        int size = Math.round(30 * getResources().getDisplayMetrics().density);
+        cursorParams = new WindowManager.LayoutParams(size, size,
+                WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
+                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                        | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
+                        | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+                        | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
+                PixelFormat.TRANSLUCENT);
+        cursorParams.gravity = Gravity.TOP | Gravity.LEFT;
+        if (Build.VERSION.SDK_INT >= 28)
+            cursorParams.layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES;
+        if (Build.VERSION.SDK_INT >= 30) cursorParams.setFitInsetsTypes(0);
+        if (Build.VERSION.SDK_INT >= 33)
+            registerReceiver(screenOff, new IntentFilter(Intent.ACTION_SCREEN_OFF), Context.RECEIVER_NOT_EXPORTED);
+        else registerReceiver(screenOff, new IntentFilter(Intent.ACTION_SCREEN_OFF));
+        receiverRegistered = true;
+        updateVisibility();
+    }
+
+    private boolean usable() {
+        KeyguardManager keyguard = getSystemService(KeyguardManager.class);
+        return sessionVisible && imeTop > 1 && keyguard != null && !keyguard.isKeyguardLocked();
+    }
+
+    @SuppressWarnings("deprecation")
+    private void updateVisibility() {
+        if (wm == null) return;
+        if (!usable()) {
+            epoch++;
+            queue.clear();
+            handler.removeCallbacks(pump);
+            busy = false;
+            dragPath = null;
+            if (attached) {
+                wm.removeView(cursor);
+                attached = false;
+            }
+            return;
+        }
+        DisplayMetrics metrics = new DisplayMetrics();
+        wm.getDefaultDisplay().getRealMetrics(metrics);
+        if (screenWidth != metrics.widthPixels || screenHeight != metrics.heightPixels) {
+            queue.clear();
+            dragPath = null;
+            screenWidth = metrics.widthPixels;
+            screenHeight = metrics.heightPixels;
+            x = screenWidth / 2f;
+            y = Math.min(imeTop, screenHeight) / 2f;
+        }
+        clampCursor();
+        positionCursor();
+        if (!attached) {
+            try {
+                wm.addView(cursor, cursorParams);
+                attached = true;
+            } catch (WindowManager.BadTokenException | IllegalStateException e) {
+                reportFailure();
+            }
+        }
+    }
+
+    private void clampCursor() {
+        x = Math.max(1, Math.min(screenWidth - 2, x));
+        y = Math.max(1, Math.min(Math.min(imeTop, screenHeight) - 2, y));
+    }
+
+    private void positionCursor() {
+        int inset = Math.round(2 * getResources().getDisplayMetrics().density);
+        cursorParams.x = Math.round(x) - inset;
+        cursorParams.y = Math.round(y) - inset;
+        if (attached) wm.updateViewLayout(cursor, cursorParams);
+        cursor.invalidate();
+    }
+
+    public void move(float dx, float dy) {
+        if (!usable() || !attached) return;
+        x += dx;
+        y += dy;
+        clampCursor();
+        if (dragPath != null && dragPoints < 2048) {
+            dragPath.lineTo(x, y);
+            dragPoints++;
+        }
+        positionCursor();
+    }
+
+    private static Path point(float x, float y) {
+        Path path = new Path();
+        path.moveTo(x, y);
+        return path;
+    }
+
+    public void click(int count) {
+        GestureDescription.Builder builder = new GestureDescription.Builder();
+        for (int i = 0; i < count; i++)
+            builder.addStroke(new GestureDescription.StrokeDescription(point(x, y), i * 120L, 45));
+        enqueue(builder.build(), null);
+    }
+
+    public void longClick() {
+        enqueue(new GestureDescription.Builder().addStroke(
+                new GestureDescription.StrokeDescription(point(x, y), 0, 650)).build(), null);
+    }
+
+    public void scroll(float dx, float dy) {
+        if (!usable()) return;
+        float endX = Math.max(1, Math.min(screenWidth - 2, x + dx * 2));
+        float endY = Math.max(1, Math.min(Math.min(imeTop, screenHeight) - 2, y + dy * 2));
+        if (Math.hypot(endX - x, endY - y) < 2) return;
+        Path path = point(x, y);
+        path.lineTo(endX, endY);
+        enqueue(new GestureDescription.Builder().addStroke(
+                new GestureDescription.StrokeDescription(path, 0, 300)).build(), null);
+    }
+
+    public void beginDrag() {
+        if (!usable()) return;
+        dragStartX = x;
+        dragStartY = y;
+        dragPoints = 0;
+        dragPath = point(x, y);
+        cursor.invalidate();
+    }
+
+    public void cancelDrag() {
+        dragPath = null;
+        if (cursor != null) cursor.invalidate();
+    }
+
+    /** Preview follows the finger; a held, continued touch replays the path after release. */
+    public void endDrag() {
+        if (dragPath == null) return;
+        Path path = new Path(dragPath);
+        path.lineTo(x, y);
+        GestureDescription.StrokeDescription hold = new GestureDescription.StrokeDescription(
+                point(dragStartX, dragStartY), 0, 600, true);
+        GestureDescription continuation = new GestureDescription.Builder().addStroke(
+                hold.continueStroke(path, 0, Math.min(1800, Math.max(300, dragPoints * 12L)), false)).build();
+        GestureDescription release = new GestureDescription.Builder().addStroke(
+                hold.continueStroke(point(dragStartX, dragStartY), 0, 1, false)).build();
+        enqueue(new GestureDescription.Builder().addStroke(hold).build(), continuation, release);
+        cancelDrag();
+    }
+
+    private void enqueue(GestureDescription first, GestureDescription continuation) {
+        enqueue(first, continuation, null);
+    }
+
+    private void enqueue(GestureDescription first, GestureDescription continuation, GestureDescription release) {
+        if (!usable() || !attached) return;
+        if (queue.size() >= 8) { reportFailure(); return; }
+        queue.add(new PendingGesture(first, continuation, release, SystemClock.uptimeMillis()));
+        handler.removeCallbacks(pump);
+        handler.postDelayed(pump, 70);
+    }
+
+    private final Runnable pump = new Runnable() {
+        @Override public void run() {
+            if (!usable() || busy || queue.isEmpty()) return;
+            long now = SystemClock.uptimeMillis();
+            while (!queue.isEmpty() && now - queue.peek().created > 2000) queue.remove();
+            if (queue.isEmpty()) return;
+            if (touchCount > 0 || now - lastTouch < 65) {
+                handler.postDelayed(this, 80);
+                return;
+            }
+            PendingGesture next = queue.remove();
+            busy = true;
+            dispatch(next.first, next.continuation, next.release, epoch);
+        }
+    };
+
+    private void dispatch(GestureDescription gesture, GestureDescription continuation,
+            GestureDescription release, int generation) {
+        boolean accepted = dispatchGesture(gesture, new GestureResultCallback() {
+            @Override public void onCompleted(GestureDescription completed) {
+                if (generation != epoch || !usable() || touchCount > 0) {
+                    // Lift an already-held drag even if the IME disappeared during its hold.
+                    // This is a continuation at the existing touch, never a new click.
+                    if (continuation != null && release != null) dispatchGesture(release, null, handler);
+                    if (generation == epoch) {
+                        busy = false;
+                        queue.clear();
+                    }
+                    return;
+                }
+                if (continuation != null && usable() && touchCount == 0) {
+                    dispatch(continuation, null, release, generation);
+                    return;
+                }
+                busy = false;
+                handler.post(pump);
+            }
+            @Override public void onCancelled(GestureDescription cancelled) {
+                if (generation != epoch) return;
+                busy = false;
+                queue.clear();
+                reportFailure();
+            }
+        }, handler);
+        if (!accepted) {
+            if (continuation == null && release != null) dispatchGesture(release, null, handler);
+            busy = false;
+            queue.clear();
+            reportFailure();
+        }
+    }
+
+    private void reportFailure() {
+        long now = SystemClock.uptimeMillis();
+        if (now - lastFailure > 3000) {
+            Toast.makeText(this, R.string.fold_gesture_failed, Toast.LENGTH_SHORT).show();
+            lastFailure = now;
+        }
+    }
+
+    @Override public void onAccessibilityEvent(AccessibilityEvent event) {
+        // No node tree, text, or content is requested or retained.
+        if (!usable()) updateVisibility();
+    }
+    @Override public void onInterrupt() { hideSession(); }
+    @Override public void onConfigurationChanged(Configuration config) {
+        super.onConfigurationChanged(config);
+        hideSession(); // Wait for fresh IME geometry before accepting coordinates again.
+    }
+    @Override public void onDestroy() {
+        hideSession();
+        handler.removeCallbacksAndMessages(null);
+        if (instance == this) instance = null;
+        if (receiverRegistered) unregisterReceiver(screenOff);
+        super.onDestroy();
+    }
+
+    private static final class PendingGesture {
+        final GestureDescription first, continuation, release;
+        final long created;
+        PendingGesture(GestureDescription first, GestureDescription continuation, GestureDescription release, long created) {
+            this.first = first;
+            this.continuation = continuation;
+            this.release = release;
+            this.created = created;
+        }
+    }
+
+    private final class CursorView extends View {
+        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path arrow = new Path();
+        CursorView(Context context) {
+            super(context);
+            setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+            arrow.moveTo(2, 2);
+            arrow.lineTo(4, 25);
+            arrow.lineTo(10, 18);
+            arrow.lineTo(15, 27);
+            arrow.lineTo(19, 25);
+            arrow.lineTo(14, 16);
+            arrow.lineTo(24, 15);
+            arrow.close();
+        }
+        @Override protected void onDraw(Canvas canvas) {
+            float density = getResources().getDisplayMetrics().density;
+            canvas.save();
+            canvas.scale(density, density);
+            paint.setStyle(Paint.Style.FILL);
+            paint.setColor(dragPath == null ? Color.WHITE : 0xFF79DFC8);
+            canvas.drawPath(arrow, paint);
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setStrokeWidth(1.4f);
+            paint.setColor(0xFF15202B);
+            canvas.drawPath(arrow, paint);
+            canvas.restore();
+        }
+    }
+}
