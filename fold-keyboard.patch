diff --git a/app/src/test/java/helium314/keyboard/fold/FoldCoreChecks.java b/app/src/test/java/helium314/keyboard/fold/FoldCoreChecks.java
new file mode 100644
index 0000000..c2890c0
--- /dev/null
+++ b/app/src/test/java/helium314/keyboard/fold/FoldCoreChecks.java
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.fold;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Shared by a standalone JDK runner and the Android Gradle unit-test task. */
+public final class FoldCoreChecks {
+    private static int assertions;
+    private static void check(boolean condition, String message) {
+        assertions++;
+        if (!condition) throw new AssertionError(message);
+    }
+    public static void main(String[] args) { runAll(); }
+    public static void runAll() {
+        assertions = 0;
+        check(!FoldLayoutPolicy.enabled("auto", 360, 800, false), "cover portrait");
+        check(!FoldLayoutPolicy.enabled("auto", 800, 360, false), "cover landscape");
+        check(FoldLayoutPolicy.enabled("auto", 800, 700, false), "inner portrait");
+        check(FoldLayoutPolicy.enabled("auto", 700, 800, false), "inner rotated");
+        check(!FoldLayoutPolicy.enabled("auto", 599, 800, false), "narrow multi-window");
+        check(!FoldLayoutPolicy.enabled("off", 1000, 900, false), "off");
+        check(!FoldLayoutPolicy.enabled("always", 1000, 900, true), "locked always");
+        check(FoldLayoutPolicy.enabled("always", 500, 400, false), "manual override");
+        check(!FoldLayoutPolicy.enabled("always", 400, 900, false), "minimum usable width");
+        check(FoldLayoutPolicy.keyboardWidth(1600, 2, 360) == 720, "45 percent");
+        check(FoldLayoutPolicy.keyboardWidth(2400, 2, 360) == 720, "phone width cap");
+        check(FoldLayoutPolicy.keyboardWidth(1600, 2, 320) == 640, "remember cover width");
+        check(FoldLayoutPolicy.gain(100, 0, 10, 2, 1) > FoldLayoutPolicy.gain(1, 0, 30, 2, 1), "acceleration");
+        check(Float.isFinite(FoldLayoutPolicy.gain(100, 100, 0, 2, 1)), "zero duration");
+
+        Recorder r = new Recorder();
+        TrackpadGestureEngine e = engine(r);
+        e.down(20, 20, 1000); e.up(1040);
+        check(r.events.isEmpty(), "tap waits for double tap");
+        e.flushTap(1339); check(r.events.isEmpty(), "tap deadline");
+        e.flushTap(1340); check(r.events.equals(List.of("click1")), "single click once");
+        e.flushTap(1400); check(r.events.size() == 1, "no repeated flush");
+
+        r = new Recorder(); e = engine(r);
+        e.down(0, 0, 1000); e.up(1040); e.down(0, 0, 1150); e.up(1200); e.flushTap(1600);
+        check(r.events.equals(List.of("click2")), "double tap does not add single clicks");
+
+        r = new Recorder(); e = engine(r);
+        e.down(0, 0, 1000); e.move(50, 20, 1016);
+        check(r.events.equals(List.of("move")), "movement has no injected click");
+        e.up(1040); e.flushTap(1400);
+        check(r.events.equals(List.of("move")), "movement release not a tap");
+
+        r = new Recorder(); e = engine(r);
+        e.down(0, 0, 1000); e.move(1, 1, 1200); e.up(1600);
+        check(r.events.equals(List.of("long")), "long press on release");
+
+        r = new Recorder(); e = engine(r);
+        e.down(0, 0, 1000); e.pointersChanged(2, 50, 50, 1010); e.move(50, 80, 1020);
+        check(r.events.isEmpty(), "no injection with fingers down");
+        e.pointersChanged(1, 0, 0, 1030); e.move(500, 500, 1040);
+        check(r.events.isEmpty(), "no jump when one scroll finger lifts");
+        e.up(1050);
+        check(r.events.equals(List.of("scroll")) && r.scrollY == 30, "scroll exact centroid delta after release");
+
+        r = new Recorder(); e = engine(r);
+        e.down(0, 0, 1000); e.pointersChanged(2, 100, 100, 1010); e.up(1050);
+        check(r.events.isEmpty(), "two-finger tap causes no accidental click");
+
+        r = new Recorder(); e = engine(r);
+        e.down(0, 0, 1000); e.up(1040); e.down(0, 0, 1150); e.move(50, 0, 1166);
+        check(r.events.equals(List.of("begin", "move")), "double tap drag previews first");
+        e.up(1200); e.flushTap(1600);
+        check(r.events.equals(List.of("begin", "move", "end")), "drag replay only on release");
+
+        r = new Recorder(); e = engine(r);
+        e.armDrag(); e.down(0, 0, 1000); e.move(20, 0, 1016); e.cancel(); e.up(1100);
+        check(r.events.equals(List.of("begin", "move", "cancel")), "cancel never drops object");
+
+        r = new Recorder(); e = engine(r);
+        e.down(0, 0, 1000); e.up(1040); e.cancel(); e.flushTap(1400);
+        check(r.events.isEmpty(), "hiding cancels delayed click");
+
+        r = new Recorder(); e = engine(r);
+        e.armDrag(); e.down(0, 0, 1000); e.pointersChanged(2, 10, 10, 1010); e.move(10, 30, 1020); e.up(1030);
+        check(r.events.equals(List.of("begin", "cancel", "scroll")), "multi-touch cancels drag preview");
+
+        r = new Recorder(); e = engine(r);
+        e.down(0, 0, 1000); e.pointersChanged(3, 0, 0, 1010); e.move(100, 100, 1020); e.up(1030);
+        check(r.events.isEmpty(), "three fingers cancel safely");
+
+        r = new Recorder(); e = engine(r);
+        e.down(0, 0, 1000); e.move(30, 0, 1600); e.up(1700);
+        check(r.events.equals(List.of("begin", "move", "end")), "hold and move drag");
+        System.out.println("Fold core: " + assertions + " assertions passed");
+    }
+    private static TrackpadGestureEngine engine(Recorder r) {
+        return new TrackpadGestureEngine(r, 8, 2, 1, 300, 500);
+    }
+    private static final class Recorder implements TrackpadGestureEngine.Sink {
+        final List<String> events = new ArrayList<>();
+        float scrollY;
+        public void move(float dx, float dy) { events.add("move"); }
+        public void click(int count) { events.add("click" + count); }
+        public void longClick() { events.add("long"); }
+        public void scroll(float dx, float dy) { events.add("scroll"); scrollY = dy; }
+        public void beginDrag() { events.add("begin"); }
+        public void endDrag() { events.add("end"); }
+        public void cancelDrag() { events.add("cancel"); }
+    }
+}
